# --- General ---
ENV=development
FRONTEND_URL=http://localhost:5173
EXTRA_CORS_ORIGIN=
PUBLIC_API_URL=http://localhost:8000

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still uses legacy HS256 JWT signing:
SUPABASE_JWT_SECRET=

# --- Email (mock until Resend is wired) ---
EMAIL_MODE=mock
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com
RESEND_FROM_NAME=My LifeChoices
EMAIL_REPLY_TO=

# --- Secrets: generate each with `python -c "import secrets; print(secrets.token_urlsafe(48))"` ---
OTP_SECRET=
ADMIN_SECRET=
JOBS_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
